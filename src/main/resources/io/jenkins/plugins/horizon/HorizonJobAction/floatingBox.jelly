<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">
    <j:set var="action" value="${from != null ? from : it}" />
    <j:set var="lastBuild" value="${action.lastBuild}" />
    <j:set var="details" value="${action.lastRunDetails}" />

    <link rel="stylesheet" href="${resURL}/plugin/pipeline-horizon/css/horizon-float.css" />

    <div id="horizon-job-floating-card" class="horizon-floating-card">
        <div class="horizon-floating-header">
            <div class="horizon-floating-title-area">
                <span class="horizon-floating-icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                </span>
                <span class="horizon-floating-title">Pipeline Horizon</span>
                <j:if test="${lastBuild != null}">
                    <span class="horizon-floating-run-number">#${lastBuild.number}</span>
                </j:if>

                <j:if test="${details != null}">
                    <span class="horizon-float-badge status-${details.result != null ? details.result.toLowerCase() : (details.building ? 'in_progress' : 'unknown')}">
                        ${details.building ? 'BUILDING' : (details.result != null ? details.result : 'COMPLETED')}
                    </span>
                    <span class="horizon-floating-duration">${action.formatDuration(details.duration)}</span>
                    <span class="horizon-float-sep" aria-hidden="true">•</span>
                    <span class="horizon-floating-stages-count">${details.stageCount} stages</span>

                    <j:if test="${details.totalTests &gt; 0}">
                        <span class="horizon-float-sep" aria-hidden="true">•</span>
                        <span class="horizon-float-badge status-tests ${details.failedTests &gt; 0 ? 'tests-failed' : 'tests-passed'}"
                              title="${details.totalTests} tests (${details.failedTests} failed, ${details.skippedTests} skipped)">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right:3px;"><path d="M10 2v7.527a2 2 0 0 1-.211.896L4.72 20.55a1 1 0 0 0 .9 1.45h12.76a1 1 0 0 0 .9-1.45l-5.069-10.127A2 2 0 0 1 14 9.527V2"/><line x1="8" y1="2" x2="16" y2="2"/><line x1="7" y1="16" x2="17" y2="16"/></svg>
                            ${details.totalTests} Tests
                        </span>
                    </j:if>

                    <j:if test="${details.artifactCount &gt; 0}">
                        <span class="horizon-float-sep" aria-hidden="true">•</span>
                        <a href="${rootURL}/${action.job.url}${lastBuild.number}/artifact/"
                           class="horizon-float-badge status-artifacts"
                           title="${details.artifactCount} artifacts (${details.formattedTotalArtifactSize})">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right:3px;"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                            ${details.artifactCount} Artifacts
                            <j:if test="${not empty details.formattedTotalArtifactSize}">
                                <span class="horizon-float-artifact-size">(${details.formattedTotalArtifactSize})</span>
                            </j:if>
                        </a>
                    </j:if>
                </j:if>
            </div>

            <div class="horizon-floating-actions">
                <j:if test="${lastBuild != null}">
                    <a href="${rootURL}/${action.job.url}lastBuild/horizon/" class="jenkins-button jenkins-button--primary horizon-cta-btn">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right:5px;"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                        Open in Pipeline Horizon
                    </a>
                </j:if>
                <a href="${rootURL}/${action.job.url}horizon/" class="jenkins-button horizon-secondary-btn" title="View historical runs and branch activity">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right:4px;"><path d="M4 6h16M4 12h16M4 18h7"/></svg>
                    Job Activity
                </a>
            </div>
        </div>

        <j:if test="${lastBuild == null}">
            <div class="horizon-floating-empty">
                <p>No pipeline runs recorded yet. Start a build to view the real-time DAG graph in Pipeline Horizon.</p>
            </div>
        </j:if>

        <j:if test="${details != null and not empty details.stages}">
            <j:choose>
                <!-- For high stage counts (> 8 stages), use a sleek segmented pipeline rail -->
                <j:when test="${details.stages.size() &gt; 8}">
                    <div class="horizon-float-rail-wrapper">
                        <div class="horizon-float-rail-track">
                            <j:forEach var="st" items="${details.stages}">
                                <a href="${rootURL}/${action.job.url}${lastBuild.number}/horizon/#stage=${st.id}"
                                   class="horizon-float-rail-seg status-${st.status.toLowerCase()}"
                                   title="${st.name} (${st.status}) - ${action.formatDuration(st.durationMillis)}${st.hasArtifacts ? ' - ' + st.artifactCount + ' artifacts' : ''}">
                                </a>
                            </j:forEach>
                        </div>
                        <div class="horizon-float-rail-meta">
                            <span class="horizon-float-rail-first">Stage 1: ${details.stages[0].name}</span>
                            <span class="horizon-float-rail-summary">
                                ${details.stages.size()} stages total (${details.failedStageCount == 0 ? 'all passed' : details.failedStageCount + ' failed'})
                            </span>
                            <span class="horizon-float-rail-last">Stage ${details.stages.size()}: ${details.stages[details.stages.size() - 1].name}</span>
                        </div>
                    </div>
                </j:when>

                <!-- For standard stage counts (<= 8 stages), use compact connected pills -->
                <j:otherwise>
                    <div class="horizon-float-stage-track">
                        <j:forEach var="st" items="${details.stages}" varStatus="loop">
                            <div class="horizon-float-stage-wrapper">
                                <a href="${rootURL}/${action.job.url}${lastBuild.number}/horizon/#stage=${st.id}"
                                   class="horizon-float-stage-pill status-${st.status.toLowerCase()}"
                                   title="${st.name} (${st.status}) - ${action.formatDuration(st.durationMillis)}${st.hasArtifacts ? ' - ' + st.artifactCount + ' artifacts' : ''}">
                                    <span class="horizon-float-stage-status-dot"></span>
                                    <span class="horizon-float-stage-name">${st.name}</span>
                                    <j:if test="${st.hasArtifacts}">
                                        <span class="horizon-float-stage-artifact-icon" title="${st.artifactCount} artifacts in this stage" aria-hidden="true">
                                            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                                        </span>
                                    </j:if>
                                    <span class="horizon-float-stage-duration">${action.formatDuration(st.durationMillis)}</span>
                                </a>
                                <j:if test="${!loop.last}">
                                    <span class="horizon-float-stage-arrow" aria-hidden="true">&#8594;</span>
                                </j:if>
                            </div>
                        </j:forEach>
                    </div>
                </j:otherwise>
            </j:choose>
        </j:if>
    </div>

    <script type="text/javascript">
        (function() {
            function hoistHorizonCard() {
                var card = document.getElementById('horizon-job-floating-card');
                if (!card) return;
                var parent = card.parentElement;
                if (!parent) return;
                var isFloated = (parent.style &amp;&amp; parent.style.float === 'right') ||
                                (window.getComputedStyle &amp;&amp; window.getComputedStyle(parent).float === 'right');
                if (isFloated) {
                    var mainPanel = document.getElementById('main-panel');
                    if (mainPanel) {
                        var desc = document.getElementById('description');
                        if (desc &amp;&amp; desc.parentElement === mainPanel) {
                            desc.insertAdjacentElement('afterend', card);
                        } else {
                            parent.parentElement.insertBefore(card, parent);
                        }
                    }
                }
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', hoistHorizonCard);
            } else {
                hoistHorizonCard();
            }
        })();
    </script>
</j:jelly>
