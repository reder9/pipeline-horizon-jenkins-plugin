<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">
    <l:layout title="Pipeline Horizon - ${it.job.fullDisplayName}">
        <l:header>
            <link rel="stylesheet" href="${resURL}/plugin/pipeline-horizon/css/horizon-job.css" />
            <script>
                (function() {
                    try {
                        if (typeof Document !== 'undefined' &amp;&amp; Document.prototype.querySelector &amp;&amp; !Document.prototype.querySelector.__horizon_shimmed) {
                            var origQS = Document.prototype.querySelector;
                            var origQSA = Document.prototype.querySelectorAll;
                            var shimmedQS = function(selector) {
                                try {
                                    return origQS.apply(this, arguments);
                                } catch (err) {
                                    if (typeof selector === 'string' &amp;&amp; selector.indexOf('.dialog-') === 0 &amp;&amp; selector.indexOf('-hash') !== -1) {
                                        return null;
                                    }
                                    throw err;
                                }
                            };
                            shimmedQS.__horizon_shimmed = true;
                            Document.prototype.querySelector = shimmedQS;

                            var shimmedQSA = function(selector) {
                                try {
                                    return origQSA.apply(this, arguments);
                                } catch (err) {
                                    if (typeof selector === 'string' &amp;&amp; selector.indexOf('.dialog-') === 0 &amp;&amp; selector.indexOf('-hash') !== -1) {
                                        return [];
                                    }
                                    throw err;
                                }
                            };
                            shimmedQSA.__horizon_shimmed = true;
                            Document.prototype.querySelectorAll = shimmedQSA;
                        }
                    } catch(e) {}
                })();
            </script>
        </l:header>
        <l:side-panel>
            <st:include page="sidepanel.jelly" it="${it.job}" />
        </l:side-panel>
        <l:main-panel>
            <j:set var="jobBase" value="${rootURL}/${it.job.url}" />
            <div id="horizon-job-app"
                 class="horizon-container"
                 data-pref-theme="${it.userProperty != null ? it.userProperty.themeChoice : 'auto'}">
                <script>
                    (function() {
                        try {
                            if (typeof Document !== 'undefined' &amp;&amp; Document.prototype.querySelector &amp;&amp; !Document.prototype.querySelector.__horizon_shimmed) {
                                var origQS = Document.prototype.querySelector;
                                var origQSA = Document.prototype.querySelectorAll;
                                var shimmedQS = function(selector) {
                                    try {
                                        return origQS.apply(this, arguments);
                                    } catch (err) {
                                        if (typeof selector === 'string' &amp;&amp; selector.indexOf('.dialog-') === 0 &amp;&amp; selector.indexOf('-hash') !== -1) {
                                            return null;
                                        }
                                        throw err;
                                    }
                                };
                                shimmedQS.__horizon_shimmed = true;
                                Document.prototype.querySelector = shimmedQS;

                                var shimmedQSA = function(selector) {
                                    try {
                                        return origQSA.apply(this, arguments);
                                    } catch (err) {
                                        if (typeof selector === 'string' &amp;&amp; selector.indexOf('.dialog-') === 0 &amp;&amp; selector.indexOf('-hash') !== -1) {
                                            return [];
                                        }
                                        throw err;
                                    }
                                };
                                shimmedQSA.__horizon_shimmed = true;
                                Document.prototype.querySelectorAll = shimmedQSA;
                            }
                        } catch(e) {}
                        try {
                            var app = document.getElementById('horizon-job-app');
                            var pref = (app ? app.getAttribute('data-pref-theme') : null) || 'auto';
                            var isDark = false;
                            if (pref === 'dark') {
                                isDark = true;
                            } else if (pref === 'light') {
                                isDark = false;
                            } else {
                                var html = document.documentElement;
                                var body = document.body;
                                var th = (html ? html.getAttribute('data-theme') : '') || (body ? body.getAttribute('data-theme') : '') || '';
                                var tm = document.getElementById('theme-manager-theme');
                                if (tm &amp;&amp; tm.textContent) {
                                    try {
                                        var parsed = JSON.parse(tm.textContent);
                                        if (parsed.id === 'dark') isDark = true;
                                        else if (parsed.id === 'light') isDark = false;
                                    } catch(e) {}
                                }
                                if (th.indexOf('dark') !== -1) {
                                    isDark = true;
                                } else if (!th &amp;&amp; window.matchMedia &amp;&amp; window.matchMedia('(prefers-color-scheme: dark)').matches) {
                                    isDark = true;
                                }
                            }
                            if (app) {
                                if (isDark) {
                                    app.classList.add('theme-dark');
                                    app.classList.remove('theme-light');
                                } else {
                                    app.classList.add('theme-light');
                                    app.classList.remove('theme-dark');
                                }
                            }
                        } catch(e) {}
                    })();
                </script>

                <!-- Hero Header -->
                <header class="horizon-hero" role="banner" aria-label="Pipeline Job Overview">
                    <div class="hero-title-group">
                        <h1 id="job-title">${it.job.displayName}</h1>
                        <p class="hero-desc" id="job-desc">${it.job.description != null ? it.job.description : 'Pipeline Project'}</p>
                    </div>
                    <div class="hero-actions">
                        <button id="btn-run-pipeline" class="btn-primary" onclick="triggerBuild()" aria-label="Run Pipeline">
                            <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:-1px;"><polygon points="5 3 19 12 5 21 5 3"/></svg> Run Pipeline
                        </button>
                        <a href="${jobBase}configure" class="btn-secondary" aria-label="Configure Jenkins Job">
                            Configure
                        </a>
                        <j:set var="prefTargetUrl" value="${it.userProfileUrl != null ? it.userProfileUrl : (rootURL + '/user/' + (app.me != null ? app.me.id : '') + '/preferences')}" />
                        <j:if test="${app.me != null || it.userProfileUrl != null}">
                            <a href="${prefTargetUrl}" class="btn-secondary" target="_blank" aria-label="Pipeline Horizon User Preferences">
                                Preferences
                            </a>
                        </j:if>
                    </div>
                </header>

                <!-- Filters and Search Bar -->
                <nav class="filter-bar" role="search" aria-label="Filter and search pipeline runs">
                    <div class="search-box">
                        <input type="text" id="run-search" class="search-input" placeholder="Search by build number, commit or trigger cause..." aria-label="Search by build number, commit or trigger cause" onkeyup="filterRuns()" />
                    </div>
                    <div class="status-filters" role="tablist" aria-label="Filter runs by status">
                        <button type="button" class="filter-pill active" role="tab" aria-selected="true" onclick="setStatusFilter('ALL', this)" onkeydown="handleFilterKeyNav(event, 'ALL', this)">All Runs</button>
                        <button type="button" id="pill-filter-queued" class="filter-pill" style="display:none;" role="tab" aria-selected="false" onclick="setStatusFilter('QUEUED', this)" onkeydown="handleFilterKeyNav(event, 'QUEUED', this)">Queued (<span id="pill-queued-count">0</span>)</button>
                        <button type="button" class="filter-pill" role="tab" aria-selected="false" onclick="setStatusFilter('SUCCESS', this)" onkeydown="handleFilterKeyNav(event, 'SUCCESS', this)">Success</button>
                        <button type="button" class="filter-pill" role="tab" aria-selected="false" onclick="setStatusFilter('UNSTABLE', this)" onkeydown="handleFilterKeyNav(event, 'UNSTABLE', this)">Unstable</button>
                        <button type="button" class="filter-pill" role="tab" aria-selected="false" onclick="setStatusFilter('FAILED', this)" onkeydown="handleFilterKeyNav(event, 'FAILED', this)">Failed</button>
                        <button type="button" class="filter-pill" role="tab" aria-selected="false" onclick="setStatusFilter('ABORTED', this)" onkeydown="handleFilterKeyNav(event, 'ABORTED', this)">Aborted</button>
                        <button type="button" class="filter-pill" role="tab" aria-selected="false" onclick="setStatusFilter('IN_PROGRESS', this)" onkeydown="handleFilterKeyNav(event, 'IN_PROGRESS', this)">Running</button>
                    </div>
                </nav>

                <!-- Queued Builds Banner -->
                <div id="job-queued-banner" class="job-queued-banner" style="display:none;" role="status">
                    <div class="queued-banner-content">
                        <span class="queued-banner-dot"></span>
                        <span id="job-queued-banner-text">1 build currently waiting in queue</span>
                    </div>
                    <div id="job-queued-banner-actions"></div>
                </div>

                <!-- Runs Activity Feed -->
                <section class="runs-card" role="region" aria-label="Pipeline Build History">
                    <table class="runs-table" aria-label="Pipeline execution runs">
                        <thead>
                            <tr>
                                <th scope="col">Build</th>
                                <th scope="col">Status</th>
                                <th scope="col">Trigger / Commit</th>
                                <th scope="col">Duration</th>
                                <th scope="col">Completed</th>
                                <th scope="col">Horizon Actions</th>
                            </tr>
                        </thead>
                        <tbody id="runs-tbody">
                            <tr>
                                <td colspan="6" style="text-align:center; padding: 2.5rem; color:#475569;">
                                    Loading pipeline activity...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </section>
                <!-- Build with Parameters Modal Dialog -->
                <div id="horizon-build-modal" class="horizon-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modal-build-title">
                    <div class="horizon-modal-dialog">
                        <div class="horizon-modal-header">
                            <h2 class="horizon-modal-title" id="modal-build-title">
                                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                Build with Parameters
                            </h2>
                            <button class="horizon-modal-close" onclick="closeBuildModal()" aria-label="Close build parameters dialog" title="Close">
                                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                            </button>
                        </div>
                        <div id="modal-params-body" class="horizon-modal-body">
                            <!-- Dynamically generated parameter fields -->
                        </div>
                        <div class="horizon-modal-footer">
                            <button class="btn-modal-cancel" onclick="closeBuildModal()">Cancel</button>
                            <button class="btn-modal-submit" id="btn-submit-build" onclick="submitParameterizedBuild()">
                                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                Run Build
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Horizon Job Configuration & Client Script -->
            <script>
                window.HORIZON_JOB_CONFIG = {
                    jobBaseUrl: "${jobBase}"
                };
            </script>
            <script src="${resURL}/plugin/pipeline-horizon/js/horizon-job.js"></script>
        </l:main-panel>
    </l:layout>
</j:jelly>
