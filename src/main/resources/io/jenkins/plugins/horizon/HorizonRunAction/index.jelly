                    }
                    .horizon-container.theme-dark .stage-node.status-UNSTABLE::before,
                    .horizon-container.theme-dark .stage-node.status-UNSTABLE::after {
                        background: #f59e0b;
                        border-color: #0f172a;
                    }
                    .horizon-container.theme-dark .stage-node.status-ABORTED::before,
                    .horizon-container.theme-dark .stage-node.status-ABORTED::after {
                        background: #64748b;
                        border-color: #0f172a;
                    }
