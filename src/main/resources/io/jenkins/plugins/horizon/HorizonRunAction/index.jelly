                    }
                    .horizon-container.theme-dark .flow-junction-dot.flow-success { fill: #10b981; }
                    .horizon-container.theme-dark .flow-junction-dot.flow-failed { fill: #ef4444; }
                    .horizon-container.theme-dark .flow-junction-dot.flow-unstable { fill: #f59e0b; }
                    .horizon-container.theme-dark .flow-junction-dot.flow-skipped { fill: #64748b; }
                    .horizon-container.theme-dark .flow-junction-dot.flow-in-progress { fill: #38bdf8; }
                    .horizon-container.theme-dark .flow-junction-dot.flow-neutral { fill: #475569; }
                    .horizon-container.theme-dark .stage-node::before,
                    .horizon-container.theme-dark .stage-node::after {
                        border-color: #0f172a;
                        background: #475569;
