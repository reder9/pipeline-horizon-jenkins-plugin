                        background: linear-gradient(90deg, #0284c7, #38bdf8, #0284c7);
                    }
                    .horizon-container.theme-dark .stage-node.selected .stage-drawer-pointer {
                        border-top-color: #38bdf8;
                        filter: drop-shadow(0 2px 4px rgba(56, 189, 248, 0.5));
                    }

                    /* Status-Aware Selected Stage Nodes (Dark Mode) */
                    .horizon-container.theme-dark .stage-node.status-FAILED.selected,
                    .horizon-container.theme-dark .stage-node.status-FAILURE.selected {
                        border-color: #ef4444 !important;
                        background: linear-gradient(180deg, rgba(239, 68, 68, 0.28) 0%, rgba(185, 28, 28, 0.2) 52%, #1e1114 100%) !important;
                        box-shadow: 0 0 0 2px #020617, 0 0 0 4.5px #ef4444, 0 0 22px 5px rgba(239, 68, 68, 0.6), 0 8px 20px rgba(0, 0, 0, 0.55) !important;
                        animation: stageActiveGlowFailed 2.6s ease-in-out infinite !important;
                    }
