                        color: #6ee7b7 !important;
                    }
                    .horizon-container.theme-dark .stage-node.status-SUCCESS.selected .stage-selected-pill {
                        background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;
                        border-color: #020617 !important;
                        box-shadow: 0 2px 8px rgba(16, 185, 129, 0.6) !important;
                    }
                    .horizon-container.theme-dark .stage-node.status-SUCCESS.selected .stage-active-strip {
                        background: linear-gradient(90deg, #059669, #34d399, #059669) !important;
                    }
                    .horizon-container.theme-dark .stage-node.status-SUCCESS.selected .stage-drawer-pointer {
                        border-top-color: #10b981 !important;
                        filter: drop-shadow(0 2px 4px rgba(16, 185, 129, 0.5)) !important;
                    }

                    .horizon-container.theme-dark .stage-node.status-UNSTABLE.selected {
                        border-color: #f59e0b !important;
                        background: linear-gradient(180deg, rgba(245, 158, 11, 0.24) 0%, rgba(217, 119, 6, 0.16) 52%, #201b10 100%) !important;
                        box-shadow: 0 0 0 2px #020617, 0 0 0 4.5px #f59e0b, 0 0 22px 5px rgba(245, 158, 11, 0.55), 0 8px 20px rgba(0, 0, 0, 0.55) !important;
                        animation: stageActiveGlowUnstable 2.6s ease-in-out infinite !important;
                    }
                    .horizon-container.theme-dark .stage-node.status-UNSTABLE.selected .stage-name {
                        color: #fde68a !important;
                    }
                    .horizon-container.theme-dark .stage-node.status-UNSTABLE.selected .stage-selected-pill {
                        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%) !important;
                        border-color: #020617 !important;
                        box-shadow: 0 2px 8px rgba(245, 158, 11, 0.6) !important;
                    }
                    .horizon-container.theme-dark .stage-node.status-UNSTABLE.selected .stage-active-strip {
                        background: linear-gradient(90deg, #d97706, #fbbf24, #d97706) !important;
                    }
                    .horizon-container.theme-dark .stage-node.status-UNSTABLE.selected .stage-drawer-pointer {
                        border-top-color: #f59e0b !important;
