                    .horizon-container.theme-dark .stage-node.status-ABORTED.selected,
                    .horizon-container.theme-dark .stage-node.status-SKIPPED_CONDITIONAL.selected,
                    .horizon-container.theme-dark .stage-node.status-SKIPPED_UPSTREAM.selected,
