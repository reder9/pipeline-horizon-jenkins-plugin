                    .horizon-container.theme-dark .stage-node.selected {
                        background: linear-gradient(180deg, rgba(56, 189, 248, 0.24) 0%, rgba(14, 116, 144, 0.16) 52%, #1e293b 100%) !important;
                        border-color: #38bdf8 !important;
                        border-width: 2px !important;
                        box-shadow: 0 0 0 2px #020617, 0 0 0 4.5px #38bdf8, 0 0 22px 5px rgba(56, 189, 248, 0.5), 0 8px 20px rgba(0, 0, 0, 0.55) !important;
                        transform: none;
                        opacity: 1 !important;
                        z-index: 20 !important;
                        animation: stageActiveGlowDark 2.6s ease-in-out infinite !important;
                    }
                    .horizon-container.theme-dark .stage-node.selected .stage-name {
                        font-weight: 800 !important;
                        color: #ffffff !important;
                    }
                    .horizon-container.theme-dark .stage-selected-pill {
                        background: linear-gradient(135deg, #38bdf8 0%, #0284c7 100%);
