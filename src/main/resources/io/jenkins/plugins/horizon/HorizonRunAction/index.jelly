                    .horizon-container.theme-dark .stage-node.status-FAILURE.selected .stage-selected-pill {
                        background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%) !important;
                        border-color: #020617 !important;
                        box-shadow: 0 2px 8px rgba(239, 68, 68, 0.65) !important;
                    }
