<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">
    <l:layout title="Pipeline Horizon - ${it.run.fullDisplayName}">
        <l:header>
            <link rel="stylesheet" href="${resURL}/plugin/pipeline-horizon/css/horizon-run.css" />
            <script>
                (function() {
                    // Defensive guard for Jenkins Core dialog hash lookup bug (app.js dialogs_init)
                    // Jenkins core app.js executes: document.querySelector(".dialog-" + window.location.hash.substring(1) + "-hash")
                    // If the hash contains '=' or '&amp;', unescaped CSS class selectors throw a fatal SyntaxError.
                    try {
                        if (typeof Document !== 'undefined' &amp;&amp; Document.prototype.querySelector &amp;&amp; !Document.prototype.querySelector.__horizon_shimmed) {
                            var origQS = Document.prototype.querySelector;
                            var origQSA = Document.prototype.querySelectorAll;
                            var shimmedQS = function(selector) {
                                try {
                                    return origQS.apply(this, arguments);
                                } catch (err) {
                                    if (typeof selector === 'string' &amp;&amp; selector.indexOf('.dialog-') === 0 &amp;&amp; selector.indexOf('-hash') !== -1) {
                                        return null;
                                    }
                                    throw err;
                                }
                            };
                            shimmedQS.__horizon_shimmed = true;
                            Document.prototype.querySelector = shimmedQS;

                            var shimmedQSA = function(selector) {
                                try {
                                    return origQSA.apply(this, arguments);
                                } catch (err) {
                                    if (typeof selector === 'string' &amp;&amp; selector.indexOf('.dialog-') === 0 &amp;&amp; selector.indexOf('-hash') !== -1) {
                                        return [];
                                    }
                                    throw err;
                                }
                            };
                            shimmedQSA.__horizon_shimmed = true;
                            Document.prototype.querySelectorAll = shimmedQSA;
                        }
                        if (typeof window !== 'undefined' &amp;&amp; typeof window.fetch === 'function') {
                            var preloadRunBase = "${rootURL}/${it.run.url}";
                            if (preloadRunBase.charAt(preloadRunBase.length - 1) !== '/') preloadRunBase += '/';
                            window._horizonInitialCanvasPromise = window.fetch(preloadRunBase + 'horizon/apiGraph?view=canvas')
                                .then(function(r) { return r.ok ? r.json() : null; })
                                .catch(function() { return null; });
                        }
                    } catch(e) {}
                })();
            </script>
        </l:header>
        <l:side-panel>
            <st:include page="sidepanel.jelly" it="${it.run}" />
        </l:side-panel>
        <l:main-panel>
            <j:set var="runBase" value="${rootURL}/${it.run.url}" />
            <j:set var="jobBase" value="${rootURL}/${it.run.parent.url}" />
            <j:set var="appRootUrl" value="${rootURL}/" />
            <div id="horizon-run-app"
                 class="horizon-container"
                 data-pref-theme="${it.userProperty != null ? it.userProperty.themeChoice : 'auto'}"
                 data-pref-layout="${it.userProperty != null ? it.userProperty.defaultLayout : 'scroll'}"
                 data-pref-density="${it.userProperty != null ? it.userProperty.defaultDensity : 'comfort'}"
                 data-pref-hide-skipped="${it.userProperty != null ? it.userProperty.defaultHideSkipped : false}"
                 data-pref-auto-copy="${it.userProperty != null ? it.userProperty.autoCopyLineLink : false}">
                <script>
                    (function() {
                        try {
                            if (typeof Document !== 'undefined' &amp;&amp; Document.prototype.querySelector &amp;&amp; !Document.prototype.querySelector.__horizon_shimmed) {
                                var origQS = Document.prototype.querySelector;
                                var origQSA = Document.prototype.querySelectorAll;
                                var shimmedQS = function(selector) {
                                    try {
                                        return origQS.apply(this, arguments);
                                    } catch (err) {
                                        if (typeof selector === 'string' &amp;&amp; selector.indexOf('.dialog-') === 0 &amp;&amp; selector.indexOf('-hash') !== -1) {
                                            return null;
                                        }
                                        throw err;
                                    }
                                };
                                shimmedQS.__horizon_shimmed = true;
                                Document.prototype.querySelector = shimmedQS;

                                var shimmedQSA = function(selector) {
                                    try {
                                        return origQSA.apply(this, arguments);
                                    } catch (err) {
                                        if (typeof selector === 'string' &amp;&amp; selector.indexOf('.dialog-') === 0 &amp;&amp; selector.indexOf('-hash') !== -1) {
                                            return [];
                                        }
                                        throw err;
                                    }
                                };
                                shimmedQSA.__horizon_shimmed = true;
                                Document.prototype.querySelectorAll = shimmedQSA;
                            }
                        } catch(e) {}
                        try {
                            var app = document.getElementById('horizon-run-app');
                            var pref = (app ? app.getAttribute('data-pref-theme') : null) || 'auto';
                            var isDark = false;
                            if (pref === 'dark') {
                                isDark = true;
                            } else if (pref === 'light') {
                                isDark = false;
                            } else {
                                var html = document.documentElement;
                                var body = document.body;
                                var th = (html ? html.getAttribute('data-theme') : '') || (body ? body.getAttribute('data-theme') : '') || '';
                                var tm = document.getElementById('theme-manager-theme');
                                if (tm &amp;&amp; tm.textContent) {
                                    try {
                                        var parsed = JSON.parse(tm.textContent);
                                        if (parsed.id === 'dark') isDark = true;
                                        else if (parsed.id === 'light') isDark = false;
                                    } catch(e) {}
                                }
                                if (th.indexOf('dark') !== -1) {
                                    isDark = true;
                                } else if (!th &amp;&amp; window.matchMedia &amp;&amp; window.matchMedia('(prefers-color-scheme: dark)').matches) {
                                    isDark = true;
                                }
                            }
                            var app = document.getElementById('horizon-run-app');
                            if (app) {
                                if (isDark) {
                                    app.classList.add('theme-dark');
                                    app.classList.remove('theme-light');
                                } else {
                                    app.classList.add('theme-light');
                                    app.classList.remove('theme-dark');
                                }
                            }
                        } catch(e) {}
                    })();
                </script>

                <!-- Floating exit button permanently available in Fullscreen Canvas mode -->
                <button id="btn-fullscreen-exit-floating" class="fullscreen-exit-floating-btn" onclick="toggleScreenMode()" title="Exit Fullscreen Canvas (Esc)" aria-label="Exit Fullscreen Canvas">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    <span>Exit Fullscreen</span>
                </button>

                <!-- Top Header Bar -->
                <header class="horizon-header" role="banner" aria-label="Pipeline Run Overview">
                    <nav class="horizon-breadcrumb-bar" aria-label="Breadcrumb navigation">
                        <div style="display:flex; gap:0.85rem; align-items:center;">
                            <a href="${runBase}" class="horizon-breadcrumb-link" title="Return to classic Jenkins build page" aria-label="Return to classic Jenkins build page">
                                <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg> Classic Jenkins
                            </a>
                            <span style="color:#475569; font-size:0.75rem;" aria-hidden="true">/</span>
                            <a href="${jobBase}horizon/" class="horizon-breadcrumb-link" title="View all runs for this job" aria-label="View all runs for this job in Job Activity">
                                <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h7"/></svg> Job Activity
                            </a>
                        </div>
                        <span id="screen-mode-hint" style="font-size:0.75rem; color:#94a3b8; font-family:monospace; background:rgba(255,255,255,0.06); padding:2px 8px; border-radius:6px; border:1px solid rgba(255,255,255,0.1);">Embedded in Jenkins</span>
                    </nav>

                    <div class="horizon-title-row">
                        <div class="horizon-title-left">
                            <span id="run-status-circle" class="run-status-circle circle-in_progress" title="Build Status" aria-label="Build Status Emblem">
                                <svg aria-hidden="true" class="horizon-spin" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                            </span>
                            <div class="horizon-title-headline">
                                <h1 class="horizon-title" id="run-title">Build #${it.run.number}</h1>
                                <div id="run-nav-group" class="run-nav-group" role="group" aria-label="Navigate runs" style="display:none;">
                                    <button id="btn-prev" class="run-nav-btn" onclick="navigateBuild('prev')" title="Previous run" aria-label="Previous run">
                                        <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                                    </button>
                                    <button id="btn-next" class="run-nav-btn" onclick="navigateBuild('next')" title="Next run" aria-label="Next run">
                                        <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                                    </button>
                                </div>
                                <span id="run-badge" class="horizon-badge badge-in_progress" role="status">Loading...</span>
                                <div id="meta-commit-inline" class="horizon-commit-inline" style="display:none;"></div>
                            </div>
                        </div>
                        <div class="horizon-nav-btns">
                            <!-- Consolidated Pipeline Run Actions Dropdown -->
                            <div class="horizon-action-group" role="group" aria-label="Pipeline lifecycle actions">
                                <button id="btn-abort-run" class="horizon-btn horizon-btn-danger-action" onclick="triggerAbortRun()" style="display:none;" title="Stop / cancel this running build" aria-label="Stop running build">
                                    <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:-1px;"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
                                    <span>Stop Build</span>
                                </button>
                                <div id="pipeline-actions-dropdown-wrap" class="horizon-dropdown-wrap" style="display:none;">
                                    <button id="btn-pipeline-actions" class="horizon-btn horizon-btn-primary-action" onclick="togglePipelineActionsDropdown(event)" title="Pipeline execution actions (Rebuild, Replay, Restart from Stage)" aria-haspopup="true" aria-expanded="false" aria-label="Pipeline execution actions">
                                        <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px;"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                                        <span>Run Actions</span> &#9662;
                                    </button>
                                    <div id="pipeline-actions-menu" class="horizon-dropdown-menu pipeline-actions-dropdown" role="menu" aria-label="Pipeline execution actions">
                                        <!-- Stop Build Action inside menu -->
                                        <button class="horizon-dropdown-item action-item" id="menu-item-abort" role="menuitem" onclick="handleMenuAbort()" style="display:none;" title="Stop / abort this running build">
                                            <span class="dropdown-item-icon icon-abort" aria-hidden="true">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
                                            </span>
                                            <span class="dropdown-item-text">
                                                <span class="dropdown-item-title">Stop Build</span>
                                                <span class="dropdown-item-desc">Interrupt and cancel this in-progress run</span>
                                            </span>
                                        </button>

                                        <!-- Rebuild Action -->
                                        <button class="horizon-dropdown-item action-item" id="menu-item-rebuild" role="menuitem" onclick="handleMenuRebuild()" style="display:none;" title="Rebuild this run with the same parameters">
                                            <span class="dropdown-item-icon icon-rebuild" aria-hidden="true">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                                            </span>
                                            <span class="dropdown-item-text">
                                                <span class="dropdown-item-title">Rebuild</span>
                                                <span class="dropdown-item-desc">Re-run build with original parameters</span>
                                            </span>
                                        </button>

                                        <!-- Replay Action -->
                                        <button class="horizon-dropdown-item action-item" id="menu-item-replay" role="menuitem" onclick="handleMenuReplay()" style="display:none;" title="Inspect or modify Jenkinsfile pipeline script">
                                            <span class="dropdown-item-icon icon-replay" aria-hidden="true">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                            </span>
                                            <span class="dropdown-item-text">
                                                <span class="dropdown-item-title">Replay Pipeline...</span>
                                                <span class="dropdown-item-desc">View or edit Jenkinsfile before re-running</span>
                                            </span>
                                        </button>

                                        <!-- View Parameters Action -->
                                        <button class="horizon-dropdown-item action-item" id="menu-item-params" role="menuitem" onclick="openParametersModal()" style="display:none;" title="View build parameters">
                                            <span class="dropdown-item-icon icon-params" aria-hidden="true">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
                                            </span>
                                            <span class="dropdown-item-text">
                                                <span class="dropdown-item-title">View Parameters</span>
                                                <span class="dropdown-item-desc" id="menu-item-params-desc">Inspect parameters passed to this build</span>
                                            </span>
                                        </button>

                                        <!-- Restart from Stage Section -->
                                        <div id="menu-restart-section" style="display:none;">
                                            <div class="horizon-dropdown-divider" role="separator"></div>
                                            <div class="horizon-dropdown-header">
                                                <svg aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px;"><path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
                                                <span>Restart from Stage</span>
                                                <span id="menu-restart-count" style="margin-left:auto; font-size:0.62rem; font-weight:600; opacity:0.75; text-transform:none;"></span>
                                            </div>
                                            <div id="menu-restart-stages-list" class="restart-stages-list" role="group" aria-label="Restartable stages">
                                                <!-- Populated dynamically -->
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <span class="horizon-header-divider" aria-hidden="true"></span>

                            <!-- Compact Utility Controls -->
                            <div class="horizon-utility-group" role="toolbar" aria-label="View and tools">
                                <button id="btn-shortcuts" class="horizon-btn" onclick="openShortcutsModal()" title="Keyboard Shortcuts (?) [Press ?]" aria-label="Keyboard Shortcuts">
                                    <kbd class="hdr-shortcut-kbd">?</kbd> Shortcuts
                                </button>
                                <button id="btn-share-markdown" class="horizon-btn" onclick="copyRunMarkdownSummary()" title="Copy formatted Markdown summary for Slack / Jira / GitHub" aria-label="Copy formatted Markdown summary">
                                    <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px;"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg> Share
                                </button>
                                <button id="btn-screen-mode" class="horizon-btn" onclick="toggleScreenMode()" title="Toggle Fullscreen Canvas or Embedded Jenkins view" aria-label="Toggle Fullscreen Canvas or Embedded Jenkins view">
                                    <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px;"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 4v16"/><path d="M15 4v16"/></svg> Embedded
                                </button>
                                <a href="${runBase}console" class="horizon-btn" target="_blank" title="Open Jenkins raw console log in new tab" aria-label="Open Jenkins raw console log in new tab">
                                    <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px;"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg> Console
                                </a>
                                <j:if test="${it.userProfileUrl != null}">
                                    <a href="${it.userProfileUrl}" class="horizon-btn horizon-btn-icon" target="_blank" title="Pipeline Horizon Preferences" aria-label="Pipeline Horizon Preferences">
                                        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                                    </a>
                                </j:if>
                            </div>
                        </div>
                    </div>

                    <div class="horizon-meta-grid" role="group" aria-label="Build execution metrics">
                        <div class="meta-item" id="meta-duration-item">
                            <span class="meta-label">Duration</span>
                            <div class="meta-duration-wrap">
                                <span class="meta-value" id="meta-duration">--</span>
                                <div class="meta-duration-breakdown" id="meta-duration-breakdown" style="display:none;"></div>
                                <div id="meta-queue-wrap" class="meta-queue-wrap" style="display:none;" title="Time spent waiting in the Jenkins build queue before executor allocation">
                                    <span class="meta-queue-label">Queue wait:</span>
                                    <span class="meta-queue-val" id="meta-queue-wait">--</span>
                                </div>
                            </div>
                        </div>
                        <div class="meta-item" id="meta-cause-item">
                            <span class="meta-label">Triggered By</span>
                            <span class="meta-value" id="meta-cause">--</span>
                        </div>
                        <div class="meta-item" id="meta-agents-item" style="cursor:pointer;" role="button" tabindex="0" aria-label="View all agents used in this build" onclick="openAgentModal(null, 'ALL')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openAgentModal(null, 'ALL');}" title="Click to view all agents used in this build">
                            <span class="meta-label">Agents Used</span>
                            <span class="meta-value" id="meta-agents">--</span>
                        </div>
                        <div class="meta-item" id="meta-params-item" style="cursor:pointer;" role="button" tabindex="0" aria-label="View build parameters in modal" onclick="openParametersModal()" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openParametersModal();}" title="Click to inspect build parameters">
                            <span class="meta-label">Parameters</span>
                            <span class="meta-value" id="meta-params">--</span>
                        </div>
                        <div class="meta-item" id="meta-tests-item" style="cursor:pointer;" role="button" tabindex="0" aria-label="View test results in modal" onclick="openTestsModal()" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openTestsModal();}" title="Click to inspect test case results and failure stacktraces">
                            <span class="meta-label">Tests</span>
                            <span class="meta-value" id="meta-tests">--</span>
                        </div>
                        <div class="meta-item" id="meta-artifacts-item" style="cursor:pointer;" role="button" tabindex="0" aria-label="View archived artifacts in modal" onclick="openArtifactsModal(null)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openArtifactsModal(null);}" title="Click to view archived artifacts in modal">
                            <span class="meta-label">Artifacts</span>
                            <span class="meta-value" id="meta-artifacts">--</span>
                        </div>
                    </div>
                </header>

                <!-- Pending Input Step Approval Callout Banner -->
                <div id="pending-input-banner" class="pending-input-banner" style="display:none;" role="region" aria-live="polite" aria-label="Pipeline awaiting interactive input">
                    <div id="pending-input-content" class="pending-input-content"></div>
                </div>

                <!-- Root-Cause Failure and Exception Callout Banner -->
                <div id="root-cause-banner" class="root-cause-banner" style="display:none;" role="alert" aria-live="polite">
                    <div id="root-cause-content" class="root-cause-content"></div>
                </div>

                <!-- Pipeline Graph Canvas -->
                <section class="graph-card" role="region" aria-label="Pipeline Execution Flow">
                    <div class="graph-header">
                        <div class="graph-header-left" style="display:flex; align-items:center; gap:0.75rem;">
                            <h2 class="graph-title">Pipeline Execution Flow</h2>
                            <span id="refresh-indicator" role="status" aria-live="polite" style="font-size: 0.8rem; color: #475569;">Live updating...</span>
                        </div>
                        <div class="graph-controls">
                            <div class="ctrl-group" role="toolbar" aria-label="Layout mode">
                                <button id="ctrl-layout-scroll" class="ctrl-btn active" role="button" aria-pressed="true" aria-label="Horizontal flow layout with pan and zoom" onclick="setLayoutMode('scroll')" title="Horizontal canvas layout (Click &amp; drag to pan, toolbar to zoom)">
                                    <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px;"><line x1="18" y1="12" x2="6" y2="12"/><polyline points="10 8 6 12 10 16"/><polyline points="14 8 18 12 14 16"/></svg> Canvas Flow
                                </button>
                                <button id="ctrl-layout-wrap" class="ctrl-btn" role="button" aria-pressed="false" aria-label="Wrap flow layout" onclick="setLayoutMode('wrap')" title="Wrap stages onto multiple rows">
                                    <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px;"><polyline points="9 10 4 15 9 20"/><path d="M20 4v7a4 4 0 0 1-4 4H4"/></svg> Wrap
                                </button>
                            </div>
                            <div class="ctrl-group" role="toolbar" aria-label="Card density">
                                <button id="ctrl-density-comfort" class="ctrl-btn active" role="button" aria-pressed="true" aria-label="Expanded comfortable stage cards" onclick="setDensity('comfort')" title="Comfortable stage cards">Expanded</button>
                                <button id="ctrl-density-compact" class="ctrl-btn" role="button" aria-pressed="false" aria-label="Compact stage cards" onclick="setDensity('compact')" title="Compact stage cards">Compact</button>
                            </div>
                            <label class="ctrl-toggle-btn" title="Hide stages that were skipped by conditional when/params">
                                <input type="checkbox" id="ctrl-hide-skipped" aria-label="Hide skipped stages" onchange="toggleHideSkipped(this.checked)" />
                                <span class="ctrl-toggle-track" aria-hidden="true"></span>
                                <span class="ctrl-toggle-label">Hide Skipped</span>
                            </label>
                            <div class="stage-picker-dropdown-wrap" id="stage-picker-wrap">
                                <button type="button" class="ctrl-btn stage-picker-btn" id="btn-stage-picker" onclick="toggleStagePicker(event)" aria-haspopup="true" aria-expanded="false" title="Jump directly to any pipeline stage (Hotkey: s)">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px; flex-shrink:0;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                                    <span id="stage-picker-btn-text">Jump to Stage...</span>
                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="flex-shrink:0;"><polyline points="6 9 12 15 18 9"/></svg>
                                </button>
                                <div id="stage-picker-menu" class="stage-picker-menu" style="display:none;" role="menu">
                                    <div class="stage-picker-search-wrap">
                                        <input type="text" id="stage-picker-search-input" class="stage-picker-search" placeholder="Filter stages..." oninput="filterStagePickerItems(this.value)" onclick="event.stopPropagation()" onkeydown="handleStagePickerKey(event)" />
                                    </div>
                                    <div id="stage-picker-items" class="stage-picker-items-list" role="listbox">
                                        <!-- Dynamically rendered -->
                                    </div>
                                </div>
                            </div>
                            <div class="stage-picker-dropdown-wrap" id="graph-export-wrap">
                                <button type="button" class="ctrl-btn stage-picker-btn" id="btn-graph-export" onclick="toggleExportMenu(event)" aria-haspopup="true" aria-expanded="false" title="Export pipeline canvas or telemetry (Hotkey: e)">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px; flex-shrink:0;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                    <span>Export</span>
                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="flex-shrink:0;"><polyline points="6 9 12 15 18 9"/></svg>
                                </button>
                                <div id="graph-export-menu" class="stage-picker-menu graph-export-menu" style="display:none;" role="menu">
                                    <button type="button" class="stage-picker-item" onclick="exportPipelineCanvas('png')" role="menuitem">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:#38bdf8; flex-shrink:0;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                        <div style="display:flex; flex-direction:column; align-items:flex-start;">
                                            <span style="font-weight:600; color:#f1f5f9;">Export PNG Image</span>
                                            <span style="font-size:0.7rem; color:#94a3b8;">High-resolution DAG snapshot</span>
                                        </div>
                                    </button>
                                    <button type="button" class="stage-picker-item" onclick="exportPipelineCanvas('svg')" role="menuitem">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:#c084fc; flex-shrink:0;"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                                        <div style="display:flex; flex-direction:column; align-items:flex-start;">
                                            <span style="font-weight:600; color:#f1f5f9;">Export SVG Vector</span>
                                            <span style="font-size:0.7rem; color:#94a3b8;">Scalable vector graphics</span>
                                        </div>
                                    </button>
                                    <div style="height:1px; background:rgba(255,255,255,0.08); margin:4px 0;"></div>
                                    <button type="button" class="stage-picker-item" onclick="exportPipelineJson()" role="menuitem">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:#34d399; flex-shrink:0;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                                        <div style="display:flex; flex-direction:column; align-items:flex-start;">
                                            <span style="font-weight:600; color:#f1f5f9;">Export Telemetry JSON</span>
                                            <span style="font-size:0.7rem; color:#94a3b8;">Full build nodes &amp; metrics</span>
                                        </div>
                                    </button>
                                    <button type="button" class="stage-picker-item" onclick="copyPipelineJsonToClipboard()" role="menuitem">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:#fbbf24; flex-shrink:0;"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                                        <div style="display:flex; flex-direction:column; align-items:flex-start;">
                                            <span style="font-weight:600; color:#f1f5f9;">Copy JSON to Clipboard</span>
                                            <span style="font-size:0.7rem; color:#94a3b8;">Quick copy build model</span>
                                        </div>
                                    </button>
                                </div>
                            </div>
                            <button type="button" class="ctrl-btn stage-picker-btn" id="btn-minimize-graph" onclick="toggleGraphMinimized()" aria-pressed="false" title="Minimize pipeline graph into a compact stage breadcrumb bar to maximize step log space">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px; flex-shrink:0;"><polyline points="4 14 10 14 10 20"/><polyline points="20 10 14 10 14 4"/><line x1="14" y1="10" x2="21" y2="3"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
                                <span id="btn-minimize-graph-label">Minimize Graph</span>
                            </button>
                        </div>
                    </div>
                    <div id="graph-minimized-strip" class="graph-minimized-strip" style="display:none;" role="navigation" aria-label="Compact pipeline stage strip"></div>
                    <div class="graph-canvas-container" style="position:relative;">
                        <div id="pipeline-flow" class="pipeline-flow" role="group" aria-label="Pipeline stage flow">
                            <div style="padding: 2rem; color: #64748b;">Loading pipeline graph...</div>
                        </div>
                        <!-- Floating Canvas Toolbar in Bottom Right -->
                        <div class="flow-canvas-toolbar" role="toolbar" aria-label="Pipeline canvas zoom controls">
                            <button id="canvas-tool-zoomout-btn" class="canvas-tool-btn" onclick="zoomOut()" title="Zoom Out (-)" aria-label="Zoom out">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            </button>
                            <span id="canvas-zoom-display" class="canvas-zoom-display" onclick="resetZoom()" title="Current zoom level — Click to reset to 100%, scroll wheel over here to zoom">100%</span>
                            <button id="canvas-tool-zoomin-btn" class="canvas-tool-btn" onclick="zoomIn()" title="Zoom In (+)" aria-label="Zoom in">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            </button>
                            <span class="canvas-tool-divider" aria-hidden="true"></span>
                            <button id="canvas-tool-fit-btn" class="canvas-tool-btn" onclick="fitFlowToScreen()" title="Fit entire pipeline to screen (f)" aria-label="Fit pipeline to screen">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
                            </button>
                            <button id="canvas-tool-grid-btn" class="canvas-tool-btn" onclick="toggleCanvasGrid()" title="Toggle canvas background dots" aria-label="Toggle canvas background dots">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="5" cy="5" r="1.5" fill="currentColor"/><circle cx="12" cy="5" r="1.5" fill="currentColor"/><circle cx="19" cy="5" r="1.5" fill="currentColor"/>
                                    <circle cx="5" cy="12" r="1.5" fill="currentColor"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/><circle cx="19" cy="12" r="1.5" fill="currentColor"/>
                                    <circle cx="5" cy="19" r="1.5" fill="currentColor"/><circle cx="12" cy="19" r="1.5" fill="currentColor"/><circle cx="19" cy="19" r="1.5" fill="currentColor"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                </section>

                <!-- Stage Header Banner and Step Accordion Drawer Panel -->
                <div id="drawer-steps-container" class="drawer-panel active" role="tabpanel" aria-labelledby="stage-banner-title">
                    <!-- Stage Header Banner (Matches Pipeline Graph View / Blue Ocean Hero Pill) -->
                    <div id="stage-header-banner" class="stage-header-banner status-unknown" role="region" aria-label="Stage Overview">
                        <div class="stage-banner-left">
                            <span id="stage-banner-status-icon" class="stage-banner-status-icon" aria-hidden="true"></span>
                            <h3 id="stage-banner-title" class="stage-banner-title">Select a stage</h3>
                            <span id="stage-banner-skipped-badge" class="stage-banner-badge stage-badge-skipped" style="display:none;">SKIPPED</span>
                            <span id="stage-banner-optional-badge" class="stage-banner-badge stage-badge-optional" style="display:none;">OPTIONAL</span>
                            <span id="stage-banner-bottleneck-badge" class="stage-banner-badge stage-badge-bottleneck" style="display:none;" title="Longest running stage in this pipeline"><svg aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:-1px; margin-right:3px; flex-shrink:0;"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>LONGEST STAGE</span>
                            <span id="stage-banner-variance-badge" class="stage-banner-badge" style="display:none;"></span>
                            <span id="stage-banner-autojump-badge" class="stage-banner-badge stage-badge-autojump" style="display:none;" title="Auto-jumped to failed step on initial load">
                                <svg aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:-1px; margin-right:3px; flex-shrink:0;"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                                <span id="stage-banner-autojump-text">AUTO-JUMP</span>
                                <button type="button" class="stage-banner-autojump-reset" onclick="event.stopPropagation(); resetPipelineViewToStart();" title="Return to the first stage of the pipeline">Reset to Start</button>
                            </span>
                        </div>
                        <div class="stage-banner-right">
                            <div id="stage-banner-duration" class="stage-banner-meta-item" title="Stage duration" style="display:none;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                <span id="stage-banner-duration-text"></span>
                            </div>
                            <div id="stage-banner-start" class="stage-banner-meta-item" title="Stage start time" style="display:none;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 14 10"/></svg>
                                <span id="stage-banner-start-text"></span>
                            </div>
                            <div id="stage-banner-agent" class="stage-banner-meta-item stage-banner-clickable" title="Agent / node — Click for details" style="display:none; cursor:pointer;" onclick="openAgentModalForCurrentStage()" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openAgentModalForCurrentStage();}" role="button" tabindex="0">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                                <span id="stage-banner-agent-text"></span>
                            </div>
                            <div class="stage-banner-actions">
                                <button id="btn-stage-menu" class="stage-menu-btn" onclick="toggleStageActionsMenu(event)" title="Stage actions" aria-label="Stage actions" aria-haspopup="true" aria-expanded="false">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg>
                                </button>
                                <div id="stage-actions-menu" class="stage-actions-dropdown-menu" role="menu">
                                    <button class="stage-actions-item" id="btn-banner-restart" onclick="triggerRestartSelectedStage()" style="display:none;" role="menuitem">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
                                        <span>Restart Stage</span>
                                    </button>
                                    <button class="stage-actions-item" id="btn-banner-share" onclick="copyCurrentDeepLink('stage')" role="menuitem">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                                        <span>Copy Stage Link</span>
                                    </button>
                                    <button class="stage-actions-item" id="btn-banner-artifacts" onclick="openArtifactsModal(selectedStageId)" style="display:none;" role="menuitem">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                                        <span id="btn-banner-artifacts-text">View Artifacts</span>
                                    </button>
                                    <a class="stage-actions-item" id="btn-banner-download-log" href="#" download="" role="menuitem">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                        <span>Download Stage Log</span>
                                    </a>
                                    <a class="stage-actions-item" id="btn-banner-plain-log" href="#" target="_blank" role="menuitem">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                                        <span>View Stage as Plain Text</span>
                                    </a>
                                    <a class="stage-actions-item" id="btn-banner-classic-log" href="#" target="_blank" style="display:none;" role="menuitem">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                        <span>Classic Stage FlowNode</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Auto-Jump Notice Bar -->
                    <div id="autojump-notice-bar" class="autojump-notice-bar" style="display:none;" role="status">
                        <div class="autojump-notice-content">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color:#ef4444; flex-shrink:0;"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                            <span id="autojump-notice-text">Auto-jumped directly to failure log.</span>
                        </div>
                        <div style="display:flex; align-items:center; gap:8px;">
                            <button type="button" class="autojump-btn-reset" onclick="resetPipelineViewToStart()">Reset to Start</button>
                            <button type="button" class="autojump-btn-dismiss" onclick="dismissAutoJumpNotice()" title="Dismiss notice">&#x2715;</button>
                        </div>
                    </div>

                    <!-- Step Toolbar: live summary, quick filters, stage search, follow toggle, block collapse -->
                    <div id="step-toolbar" class="step-toolbar" style="display:none;" role="toolbar" aria-label="Step list controls">
                        <span id="step-toolbar-summary" class="step-toolbar-summary"></span>
                        <div class="step-quick-filters" id="step-quick-filters" style="display:none;" role="group" aria-label="Quick step filter">
                            <button type="button" class="step-filter-chip active" id="step-qfilter-all" onclick="setStepQuickFilter('all')" title="Show all steps in this stage">All</button>
                            <button type="button" class="step-filter-chip" id="step-qfilter-issues" style="display:none;" onclick="setStepQuickFilter('issues')" title="Show only failed or unstable steps">Failed / Warn</button>
                            <button type="button" class="step-filter-chip" id="step-qfilter-slow" style="display:none;" onclick="setStepQuickFilter('slow')" title="Show slowest step(s) in this stage">Slowest</button>
                        </div>
                        <span id="step-now-running" class="step-now-running" style="display:none;" role="button" tabindex="0" title="Scroll to the running step"></span>
                        <div class="step-stage-search-wrap" id="step-stage-search-wrap">
                            <svg class="search-mag-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                            <input type="text" class="step-stage-search-input" id="stage-log-search" placeholder="Search stage logs (Enter / Shift+Enter)..." oninput="filterStageLogs(this.value)" onkeydown="handleStageSearchKey(event)" onclick="event.stopPropagation();" />
                            <div class="step-stage-search-stepper" id="stage-log-match-stepper" style="display:none;">
                                <span class="match-stepper-count" id="stage-match-count">0 of 0</span>
                                <button type="button" class="match-stepper-btn" onclick="stageSearchMatch(-1)" title="Previous match (Shift+Enter)">&#9650;</button>
                                <button type="button" class="match-stepper-btn" onclick="stageSearchMatch(1)" title="Next match (Enter)">&#9660;</button>
                            </div>
                        </div>
                        <span class="step-toolbar-spacer"></span>
                        <button type="button" id="btn-collapse-logs" class="step-tool-btn" onclick="collapseAllStepLogs()" title="Collapse all open step log viewers in this stage">Collapse logs</button>
                        <button type="button" id="btn-step-groups" class="step-tool-btn" style="display:none;" onclick="toggleAllClosureGroups()" title="Collapse or expand closure blocks (withCredentials, dir, timeout, ...)">Collapse blocks</button>
                        <button type="button" id="btn-step-follow" class="step-tool-btn follow-active" style="display:none;" onclick="toggleStepFollow()"></button>
                    </div>

                    <!-- Step Accordion Container -->
                    <div id="step-accordion-container" class="step-accordion-container" role="list" aria-label="Steps in selected stage">
                        <div class="step-accordion-empty">Select a stage above to view steps.</div>
                    </div>
                </div>

                <!-- Archived Artifacts Modal Overlay -->
                <div id="artifacts-modal" class="horizon-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="artifacts-modal-title" onclick="if(event.target===this)closeArtifactsModal()">
                    <div class="horizon-modal-dialog artifacts-modal-dialog">
                        <div class="horizon-modal-header">
                            <div style="display:flex; align-items:center; gap:0.6rem; min-width:0;">
                                <div class="artifact-icon" style="width:30px; height:30px; border-radius:6px; flex-shrink:0;">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                                </div>
                                <div>
                                    <h2 class="horizon-modal-title" id="artifacts-modal-title">Archived Artifacts</h2>
                                    <div id="artifacts-modal-subtitle" style="font-size:0.75rem; color:#94a3b8; font-weight:500;">Build artifacts archive</div>
                                </div>
                            </div>
                            <div style="display:flex; align-items:center; gap:0.5rem;">
                                <a id="btn-modal-classic-artifacts" href="${runBase}artifact/" target="_blank" class="horizon-tab-link" title="Open Jenkins classic artifact directory" aria-label="Classic Artifacts View">
                                    Classic View
                                    <svg aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                </a>
                                <button class="horizon-modal-close" onclick="closeArtifactsModal()" aria-label="Close artifacts modal" title="Close (Esc)">
                                    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                </button>
                            </div>
                        </div>

                        <div class="horizon-modal-body" style="padding:1.25rem; overflow-y:auto; flex:1;">
                            <!-- Per-Stage Artifact Filter Pills -->
                            <div id="artifacts-stage-pills" class="artifacts-stage-pills">
                                <!-- Populated dynamically -->
                            </div>

                            <div class="artifacts-toolbar">
                                <div class="artifacts-search-box">
                                    <svg class="artifacts-search-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                                    <input type="text" id="artifacts-search-input" class="artifacts-search-input" placeholder="Filter artifacts by filename or directory path..." aria-label="Filter artifacts" onkeyup="filterArtifacts()" />
                                </div>
                                <div class="artifacts-toolbar-actions">
                                    <span id="artifacts-stats-text" class="artifacts-stats">0 files</span>
                                    <div class="artifact-view-mode-toggle" role="group" aria-label="Artifact view style">
                                        <button id="btn-view-tree" class="artifact-mode-btn active" onclick="setArtifactViewMode('tree')" title="Folder Tree View" aria-label="Folder Tree View">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg> Tree
                                        </button>
                                        <button id="btn-view-flat" class="artifact-mode-btn" onclick="setArtifactViewMode('flat')" title="Flat List View" aria-label="Flat List View">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg> List
                                        </button>
                                    </div>
                                    <button id="btn-tree-expand-all" class="artifact-btn" onclick="toggleExpandAllTree(true)" title="Expand all folders" aria-label="Expand all folders">
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="7 13 12 18 17 13"/><polyline points="7 6 12 11 17 6"/></svg> Expand
                                    </button>
                                    <button id="btn-tree-collapse-all" class="artifact-btn" onclick="toggleExpandAllTree(false)" title="Collapse all folders" aria-label="Collapse all folders">
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="17 11 12 6 7 11"/><polyline points="17 18 12 13 7 18"/></svg> Collapse
                                    </button>
                                    <a id="btn-download-all-zip" href="${runBase}artifact/*zip*/archive.zip" class="artifact-btn artifact-btn-primary" title="Download all archived artifacts as a ZIP archive" aria-label="Download all artifacts as ZIP">
                                        <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                        Download All (.zip)
                                    </a>
                                </div>
                            </div>

                            <!-- Interactive Folder Tree View -->
                            <div id="artifacts-tree-view" class="artifacts-tree-container" role="tree" aria-label="Artifacts directory tree">
                                <!-- Populated dynamically -->
                            </div>

                            <!-- Flat Cards Grid View -->
                            <div id="artifacts-grid" class="artifacts-grid" role="list" aria-label="Archived artifacts list" style="display:none;">
                                <!-- Populated dynamically -->
                            </div>
                        </div>

                        <div class="horizon-modal-footer" style="padding:0.75rem 1.25rem; display:flex; justify-content:space-between; align-items:center;">
                            <span style="font-size:0.75rem; color:#64748b;">Press <kbd style="padding:1px 5px; border-radius:4px; border:1px solid rgba(100,116,139,0.3); font-family:monospace;">Esc</kbd> or click outside to return to steps and logs</span>
                            <button class="btn-modal-cancel" onclick="closeArtifactsModal()">Close</button>
                        </div>
                    </div>
                </div>

                <!-- Agent Details Modal Dialog -->
                <div id="agent-modal" class="horizon-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="agent-modal-title" onclick="if(event.target===this)closeAgentModal()">
                    <div class="horizon-modal-dialog agent-modal-dialog" style="max-width: 860px; width: 95%;">
                        <div class="horizon-modal-header" style="border-bottom: 1px solid var(--border-color, #e2e8f0); padding: 1rem 1.25rem;">
                            <div style="display:flex; align-items:center; gap:0.6rem; min-width:0;">
                                <div class="agent-modal-icon-badge">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
                                        <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
                                        <line x1="6" y1="6" x2="6.01" y2="6"></line>
                                        <line x1="6" y1="18" x2="6.01" y2="18"></line>
                                    </svg>
                                </div>
                                <div>
                                    <h2 class="horizon-modal-title" id="agent-modal-title" style="margin:0; font-size:1.05rem; font-weight:700;">Agent Allocation &amp; Overview</h2>
                                    <div id="agent-modal-subtitle" style="font-size:0.75rem; color:#94a3b8; font-weight:500;">Workload distribution &amp; execution metrics across all pipeline agents</div>
                                </div>
                            </div>
                            <button class="horizon-modal-close" onclick="closeAgentModal()" aria-label="Close agent modal" title="Close (Esc)">
                                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                                </svg>
                            </button>
                        </div>

                        <!-- Pinned Agent Switcher Tabs (All Agents + Individual Dedicated Agents) -->
                        <div id="agent-modal-pills" class="agent-modal-pills"></div>

                        <div class="horizon-modal-body" style="padding: 1.25rem; max-height: calc(85vh - 180px); overflow-y: auto;">
                            <!-- Overview View (Shown when 'ALL' is selected) -->
                            <div id="agent-overview-view">
                                <div class="agent-distribution-card">
                                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem; flex-wrap:wrap; gap:6px;">
                                        <span style="font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-muted, #64748b);">Workload Distribution</span>
                                        <span id="agent-distribution-summary" style="font-size:0.75rem; font-weight:600; color:var(--text-secondary, #475569);">--</span>
                                    </div>
                                    <div id="agent-distribution-bar" class="agent-distribution-bar"></div>
                                    <div id="agent-distribution-legend" class="agent-distribution-legend"></div>
                                </div>

                                <div style="margin-top: 1.25rem;">
                                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.65rem; flex-wrap:wrap; gap:8px;">
                                        <h4 style="font-size: 0.825rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin: 0; opacity: 0.85;">Agents Workload Breakdown</h4>
                                        <div style="display:flex; gap:0.4rem; align-items:center;">
                                            <button type="button" class="agent-btn-action" onclick="toggleAllAgentOverviewCards(true)" title="Expand all agent stage lists" style="font-size:0.7rem; padding:0.2rem 0.55rem;">Expand All</button>
                                            <button type="button" class="agent-btn-action" onclick="toggleAllAgentOverviewCards(false)" title="Collapse all agent stage lists" style="font-size:0.7rem; padding:0.2rem 0.55rem;">Collapse All</button>
                                        </div>
                                    </div>
                                    <div id="agent-overview-cards" class="agent-overview-cards">
                                        <!-- Dynamically populated -->
                                    </div>
                                </div>
                            </div>

                            <!-- Single Agent View (Shown when an individual agent is selected) -->
                            <div id="agent-single-view" style="display:none;">
                                <!-- Agent Name and Action Banner -->
                                <div class="agent-hero-card">
                                    <div class="agent-hero-info">
                                        <span class="agent-hero-label">EXECUTOR NODE</span>
                                        <h3 id="agent-modal-name" class="agent-hero-name">Agent Node</h3>
                                        <div class="agent-hero-status">
                                            <span class="agent-status-dot"></span>
                                            <span id="agent-modal-status-text">Active Executor</span>
                                        </div>
                                    </div>
                                    <div class="agent-hero-actions">
                                        <button id="btn-copy-agent-name" class="agent-btn-action" onclick="copyModalAgentName()" title="Copy full agent name to clipboard">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                                            <span id="btn-copy-agent-text">Copy Name</span>
                                        </button>
                                        <a id="btn-agent-node-link" href="#" target="_blank" class="agent-btn-action agent-btn-primary" title="Open Jenkins Node page in new tab">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                                            <span>Jenkins Node</span>
                                        </a>
                                    </div>
                                </div>

                                <!-- Stats Grid -->
                                <div class="agent-stats-grid">
                                    <div class="agent-stat-card">
                                        <span class="agent-stat-label">Stages Executed</span>
                                        <span id="agent-stat-stages" class="agent-stat-value">0</span>
                                    </div>
                                    <div class="agent-stat-card">
                                        <span class="agent-stat-label">Execution Time</span>
                                        <span id="agent-stat-time" class="agent-stat-value">0s</span>
                                    </div>
                                    <div class="agent-stat-card">
                                        <span class="agent-stat-label">Stage Outcomes</span>
                                        <span id="agent-stat-outcomes" class="agent-stat-value">-</span>
                                    </div>
                                </div>

                                <!-- Stages Breakdown Section -->
                                <div style="margin-top: 1.25rem;">
                                    <h4 style="font-size: 0.825rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 0.6rem 0; opacity: 0.85;">Stages Executed on this Agent</h4>
                                    <div id="agent-modal-stages-list" class="agent-stages-list">
                                        <!-- Populated dynamically -->
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="horizon-modal-footer" style="padding: 0.75rem 1.25rem; display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 0.75rem; color: #64748b;">Press <kbd style="padding: 1px 5px; border-radius: 4px; border: 1px solid rgba(100,116,139,0.3); font-family: monospace;">Esc</kbd> or click outside to close</span>
                            <button class="btn-modal-cancel" onclick="closeAgentModal()">Close</button>
                        </div>
                    </div>
                </div>

                <!-- Test Results Explorer Modal Dialog -->
                <div id="tests-modal" class="horizon-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="tests-modal-title" onclick="if(event.target===this)closeTestsModal()">
                    <div class="horizon-modal-dialog tests-modal-dialog">
                        <div class="horizon-modal-header">
                            <div style="display:flex; align-items:center; gap:0.65rem; min-width:0;">
                                <div class="artifact-icon" style="width:32px; height:32px; border-radius:8px; flex-shrink:0; background:rgba(16, 185, 129, 0.14); color:#10b981;">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v7.527a2 2 0 0 1-.211.896L4.72 20.55a1 1 0 0 0 .9 1.45h12.76a1 1 0 0 0 .9-1.45l-5.069-10.127A2 2 0 0 1 14 9.527V2"/><line x1="8" y1="2" x2="16" y2="2"/><line x1="7" y1="16" x2="17" y2="16"/></svg>
                                </div>
                                <div>
                                    <h2 class="horizon-modal-title" id="tests-modal-title">Test Results &amp; Failure Diagnostics</h2>
                                    <div id="tests-modal-subtitle" style="font-size:0.75rem; color:#94a3b8; font-weight:500;">JUnit test report breakdown and stacktrace inspector</div>
                                </div>
                            </div>
                            <div style="display:flex; align-items:center; gap:0.5rem;">
                                <a id="btn-modal-classic-tests" href="${runBase}testReport/" target="_blank" class="horizon-tab-link" title="Open Jenkins classic test report" aria-label="Classic Test Report">
                                    Classic Report
                                    <svg aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                </a>
                                <button class="horizon-modal-close" onclick="closeTestsModal()" aria-label="Close test results modal" title="Close (Esc)">
                                    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                </button>
                            </div>
                        </div>

                        <div class="horizon-modal-body" style="padding:1.25rem; overflow-y:auto; flex:1;">
                            <div id="tests-summary-cards" class="tests-summary-cards"></div>

                            <div class="tests-filter-tabs">
                                <button id="tests-tab-all" class="tests-filter-tab active" onclick="setTestsFilter('ALL')">All</button>
                                <button id="tests-tab-failed" class="tests-filter-tab" onclick="setTestsFilter('FAILED')">Failed</button>
                                <button id="tests-tab-skipped" class="tests-filter-tab" onclick="setTestsFilter('SKIPPED')">Skipped</button>
                                <button id="tests-tab-passed" class="tests-filter-tab" onclick="setTestsFilter('PASSED')">Passed</button>
                                <div class="artifacts-search-box" style="margin-left:auto; min-width:220px;">
                                    <svg class="artifacts-search-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                                    <input type="text" id="tests-search-input" class="artifacts-search-input" placeholder="Search test name, class, or error..." aria-label="Filter test cases" oninput="renderTestsModalList()" />
                                </div>
                            </div>

                            <div id="tests-cases-list" class="tests-cases-list"></div>
                        </div>

                        <div class="horizon-modal-footer" style="padding:0.75rem 1.25rem; display:flex; justify-content:space-between; align-items:center;">
                            <span style="font-size:0.75rem; color:#64748b;">Click any failed test case to expand its assertion error and full stacktrace</span>
                            <button class="btn-modal-cancel" onclick="closeTestsModal()">Close</button>
                        </div>
                    </div>
                </div>

                <!-- Build Parameters Modal Overlay -->
                <div id="parameters-modal" class="horizon-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="parameters-modal-title" onclick="if(event.target===this)closeParametersModal()">
                    <div class="horizon-modal-dialog parameters-modal-dialog">
                        <div class="horizon-modal-header">
                            <div style="display:flex; align-items:center; gap:0.6rem; min-width:0;">
                                <div class="param-modal-icon" style="width:30px; height:30px; border-radius:6px; flex-shrink:0;">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
                                </div>
                                <div>
                                    <h2 class="horizon-modal-title" id="parameters-modal-title">Build Parameters</h2>
                                    <div id="parameters-modal-subtitle" style="font-size:0.75rem; color:#94a3b8; font-weight:500;">Parameters passed to Build #${it.run.number}</div>
                                </div>
                            </div>
                            <div style="display:flex; align-items:center; gap:0.5rem;">
                                <a id="btn-modal-classic-params" href="${runBase}parameters/" target="_blank" class="horizon-tab-link" title="Open Jenkins classic parameters page" aria-label="Classic Parameters View">
                                    Classic View
                                    <svg aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                </a>
                                <button class="horizon-modal-close" onclick="closeParametersModal()" aria-label="Close build parameters modal" title="Close (Esc)">
                                    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                </button>
                            </div>
                        </div>

                        <div class="horizon-modal-body" style="padding:1.25rem; overflow-y:auto; flex:1;">
                            <div class="params-toolbar">
                                <div class="params-search-box">
                                    <svg class="params-search-icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                                    <input type="text" id="params-search-input" class="params-search-input" placeholder="Filter parameters by name or value..." aria-label="Filter build parameters" onkeyup="filterBuildParameters()" />
                                </div>
                                <div class="params-toolbar-actions">
                                    <span id="params-stats-text" class="params-stats">0 parameters</span>
                                    <button id="btn-copy-params-json" class="param-btn" onclick="copyParameters('json')" title="Copy all parameters as JSON formatted key-values" aria-label="Copy parameters as JSON">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> Copy JSON
                                    </button>
                                    <button id="btn-copy-params-env" class="param-btn" onclick="copyParameters('env')" title="Copy all parameters as KEY=VALUE environment export format" aria-label="Copy parameters as ENV">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg> Copy KEY=VAL
                                    </button>
                                </div>
                            </div>

                            <!-- Parameters List/Cards Container -->
                            <div id="params-cards-container" class="params-cards-container" role="list">
                                <!-- Dynamically rendered -->
                            </div>
                        </div>

                        <div class="horizon-modal-footer" style="padding:0.75rem 1.25rem; display:flex; justify-content:space-between; align-items:center;">
                            <span style="font-size:0.75rem; color:#64748b;" id="params-modal-footer-hint">Click Copy button to copy any parameter to clipboard</span>
                            <button class="btn-modal-cancel" onclick="closeParametersModal()">Close</button>
                        </div>
                    </div>
                </div>

                <!-- Keyboard Shortcuts Cheat Sheet Modal Dialog -->
                <div id="shortcuts-modal" class="horizon-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="shortcuts-modal-title" onclick="if(event.target===this)closeShortcutsModal()">
                    <div class="horizon-modal-dialog shortcuts-modal-dialog">
                        <div class="horizon-modal-header">
                            <div style="display:flex; align-items:center; gap:0.65rem; min-width:0;">
                                <div class="artifact-icon" style="width:32px; height:32px; border-radius:8px; flex-shrink:0; background:rgba(56, 189, 248, 0.14); color:#38bdf8;">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="2" y="4" width="20" height="16" rx="2" ry="2"/>
                                        <line x1="6" y1="8" x2="6.01" y2="8"/>
                                        <line x1="10" y1="8" x2="10.01" y2="8"/>
                                        <line x1="14" y1="8" x2="14.01" y2="8"/>
                                        <line x1="18" y1="8" x2="18.01" y2="8"/>
                                        <line x1="6" y1="12" x2="6.01" y2="12"/>
                                        <line x1="10" y1="12" x2="10.01" y2="12"/>
                                        <line x1="14" y1="12" x2="14.01" y2="12"/>
                                        <line x1="18" y1="12" x2="18.01" y2="12"/>
                                        <line x1="7" y1="16" x2="17" y2="16"/>
                                    </svg>
                                </div>
                                <div>
                                    <h2 class="horizon-modal-title" id="shortcuts-modal-title">Keyboard Shortcuts</h2>
                                    <div style="font-size:0.75rem; color:#94a3b8; font-weight:500;">Fast, keyboard-first navigation for Pipeline Horizon</div>
                                </div>
                            </div>
                            <button class="horizon-modal-close" onclick="closeShortcutsModal()" aria-label="Close shortcuts cheat sheet" title="Close (Esc)">
                                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                            </button>
                        </div>
                        <div class="horizon-modal-body" style="padding:1.25rem; overflow-y:auto; max-height:calc(85vh - 120px);">
                            <div class="shortcuts-grid">
                                <div class="shortcuts-section">
                                    <div class="shortcuts-section-title">Navigation &amp; Views</div>
                                    <div class="shortcut-row"><span class="shortcut-desc">Canvas Flow layout</span><div class="shortcut-keys"><kbd class="hkbd">1</kbd></div></div>
                                    <div class="shortcut-row"><span class="shortcut-desc">Wrap Rows layout</span><div class="shortcut-keys"><kbd class="hkbd">2</kbd></div></div>
                                    <div class="shortcut-row"><span class="shortcut-desc">Fit pipeline to screen</span><div class="shortcut-keys"><kbd class="hkbd">f</kbd></div></div>
                                    <div class="shortcut-row"><span class="shortcut-desc">Select previous / next stage</span><div class="shortcut-keys"><kbd class="hkbd">&#8592;</kbd><kbd class="hkbd">&#8594;</kbd></div></div>
                                    <div class="shortcut-row"><span class="shortcut-desc">Open stage jump picker</span><div class="shortcut-keys"><kbd class="hkbd">s</kbd></div></div>
                                    <div class="shortcut-row"><span class="shortcut-desc">Open Export menu (PNG / SVG / JSON)</span><div class="shortcut-keys"><kbd class="hkbd">e</kbd></div></div>
                                </div>
                                <div class="shortcuts-section">
                                    <div class="shortcuts-section-title">Stage Steps &amp; Logs</div>
                                    <div class="shortcut-row"><span class="shortcut-desc">Expand / collapse focused step</span><div class="shortcut-keys"><kbd class="hkbd">Enter</kbd></div></div>
                                    <div class="shortcut-row"><span class="shortcut-desc">Focus step log search</span><div class="shortcut-keys"><kbd class="hkbd">/</kbd></div></div>
                                    <div class="shortcut-row"><span class="shortcut-desc">Next search match</span><div class="shortcut-keys"><kbd class="hkbd">Enter</kbd></div></div>
                                    <div class="shortcut-row"><span class="shortcut-desc">Previous search match</span><div class="shortcut-keys"><kbd class="hkbd">Shift</kbd><span>+</span><kbd class="hkbd">Enter</kbd></div></div>
                                    <div class="shortcut-row"><span class="shortcut-desc">Toggle Live Tail auto-scroll</span><div class="shortcut-keys"><kbd class="hkbd">t</kbd></div></div>
                                </div>
                                <div class="shortcuts-section full-span">
                                    <div class="shortcuts-section-title">Modals &amp; Actions</div>
                                    <div class="shortcut-row"><span class="shortcut-desc">Toggle keyboard shortcuts cheat sheet</span><div class="shortcut-keys"><kbd class="hkbd">?</kbd></div></div>
                                    <div class="shortcut-row"><span class="shortcut-desc">Close modal or clear log search</span><div class="shortcut-keys"><kbd class="hkbd">Esc</kbd></div></div>
                                    <div class="shortcut-row"><span class="shortcut-desc">Submit Replay / Input Approval</span><div class="shortcut-keys"><kbd class="hkbd">Ctrl</kbd><span>+</span><kbd class="hkbd">Enter</kbd></div></div>
                                    <div class="shortcut-row"><span class="shortcut-desc">Open build parameters modal</span><div class="shortcut-keys"><kbd class="hkbd">p</kbd></div></div>
                                    <div class="shortcut-row"><span class="shortcut-desc">Validate script in Replay editor</span><div class="shortcut-keys"><kbd class="hkbd">Ctrl</kbd><span>+</span><kbd class="hkbd">S</kbd></div></div>
                                </div>
                            </div>
                        </div>
                        <div class="horizon-modal-footer" style="padding:0.75rem 1.25rem; display:flex; justify-content:space-between; align-items:center;">
                            <span style="font-size:0.75rem; color:#64748b;">Press <kbd class="hkbd" style="font-size:0.7rem;">Esc</kbd> anytime to dismiss</span>
                            <button class="btn-modal-cancel" onclick="closeShortcutsModal()">Got it</button>
                        </div>
                    </div>
                </div>

                <!-- Interactive Input Step Approval Modal Dialog -->
                <div id="input-approval-modal" class="horizon-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="input-approval-title" onclick="if(event.target===this)closeInputApprovalModal()">
                    <div class="horizon-modal-dialog" style="max-width: 620px; width: 95%;">
                        <div class="horizon-modal-header">
                            <h2 class="horizon-modal-title" id="input-approval-title" style="color:#a78bfa;">
                                <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="10" y1="15" x2="10" y2="9"/><line x1="14" y1="15" x2="14" y2="9"/></svg>
                                Awaiting Pipeline Input Approval
                            </h2>
                            <button class="horizon-modal-close" onclick="closeInputApprovalModal()" aria-label="Close input approval modal" title="Close">
                                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                            </button>
                        </div>
                        <div class="horizon-modal-body" id="input-approval-body">
                            <!-- Populated dynamically -->
                        </div>
                        <div class="horizon-modal-footer" id="input-approval-footer" style="justify-content:space-between;">
                            <button id="btn-modal-input-abort" class="btn-input-abort" onclick="submitModalInputAbort()">Abort Pipeline</button>
                            <div style="display:flex; gap:0.5rem;">
                                <button class="btn-modal-cancel" onclick="closeInputApprovalModal()">Close</button>
                                <button id="btn-modal-input-proceed" class="btn-input-proceed" onclick="submitModalInputProceed()">Proceed</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Replay Jenkinsfile Modal Dialog -->
                <div id="replay-modal" class="horizon-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="replay-modal-title">
                    <div class="horizon-modal-dialog">
                        <div class="horizon-modal-header">
                            <div style="display:flex; align-items:center; gap:0.65rem; min-width:0;">
                                <h2 class="horizon-modal-title" id="replay-modal-title">
                                    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                    Replay Pipeline Script
                                </h2>
                                <div id="replay-linter-pill" class="replay-linter-pill idle" title="Live Pipeline Syntax Linter Status">
                                    <span id="replay-linter-text">Ready</span>
                                </div>
                            </div>
                            <button class="horizon-modal-close" onclick="closeReplayModal()" aria-label="Close replay modal" title="Close">
                                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                            </button>
                        </div>
                        <div class="horizon-modal-body">
                            <div style="font-size:0.8rem; color:#94a3b8; line-height:1.45;">
                                Inspect or modify the Jenkinsfile pipeline definition below. Replay triggers an isolated build run with your modified script without committing changes to source control.
                            </div>
                            <div class="replay-editor-wrapper">
                                <div id="replay-editor-gutter" class="replay-editor-gutter" aria-hidden="true"></div>
                                <textarea id="replay-script-editor" class="replay-editor" aria-label="Jenkinsfile Script Content" spellcheck="false" oninput="onReplayEditorInput()"></textarea>
                            </div>
                            <div id="replay-validation-banner" class="replay-validation-banner" style="display:none;" role="region" aria-live="polite"></div>
                        </div>
                        <div class="horizon-modal-footer replay-modal-footer">
                            <div class="replay-footer-left">
                                <div class="replay-btn-wrapper">
                                    <button id="btn-validate-replay" type="button" class="btn-modal-cancel" style="display:inline-flex; align-items:center; gap:0.4rem;" onclick="validateReplayScript(true)">
                                        <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                        <span>Validate Syntax</span>
                                    </button>
                                    <div class="replay-key-subtext"><kbd id="replay-kbd-validate">Ctrl+S</kbd></div>
                                </div>
                                <div class="replay-btn-wrapper">
                                    <a href="${jobBase}pipeline-syntax/" target="_blank" rel="noopener noreferrer" class="btn-modal-cancel" style="display:inline-flex; align-items:center; gap:0.4rem; text-decoration:none;" title="Open Jenkins Pipeline Snippet Generator in a new tab">
                                        <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                        <span>Snippet Generator</span>
                                    </a>
                                    <div class="replay-key-subtext" style="opacity: 0.65; font-size: 0.62rem; color: #64748b;">new tab</div>
                                </div>
                            </div>
                            <div class="replay-footer-right">
                                <div class="replay-btn-wrapper">
                                    <button class="btn-modal-cancel" onclick="closeReplayModal()">Cancel</button>
                                    <div class="replay-key-subtext"><kbd>Esc</kbd></div>
                                </div>
                                <div class="replay-btn-wrapper">
                                    <button id="btn-submit-replay" class="btn-modal-submit" onclick="submitReplayRun()">
                                        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                        Run Replay
                                    </button>
                                    <div class="replay-key-subtext"><kbd id="replay-kbd-replay">Ctrl+Enter</kbd></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Artifact Preview Modal Dialog -->
                <div id="artifact-preview-modal" class="horizon-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="artifact-preview-title">
                    <div class="horizon-modal-dialog artifact-preview-dialog">
                        <div class="artifact-preview-header">
                            <div style="display:flex; align-items:center; gap:0.6rem; min-width:0;">
                                <div id="artifact-preview-icon" class="artifact-icon" style="width:28px; height:28px;"></div>
                                <div>
                                    <h3 class="artifact-preview-title" id="artifact-preview-title">Artifact Preview</h3>
                                    <div class="artifact-preview-path" id="artifact-preview-path">/</div>
                                </div>
                            </div>
                            <div style="display:flex; align-items:center; gap:0.5rem;">
                                <a id="artifact-preview-download" href="#" class="artifact-btn artifact-btn-primary" download="" target="_blank" title="Download this file" aria-label="Download artifact">
                                    <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                    Download
                                </a>
                                <button class="horizon-modal-close" onclick="closeArtifactPreviewModal()" aria-label="Close artifact preview modal" title="Close">
                                    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                </button>
                            </div>
                        </div>
                        <div id="artifact-preview-body" class="artifact-preview-body">
                            <!-- Populated dynamically -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Client Script -->
            <!-- Horizon Configuration & Client Script -->
            <script>
                window.HORIZON_CONFIG = {
                    runBaseUrl: "${runBase}",
                    jobBaseUrl: "${jobBase}",
                    appRootUrl: "${appRootUrl}",
                    runNumber: ${it.run.number}
                };
            </script>
            <script src="${resURL}/plugin/pipeline-horizon/js/horizon-run.js"></script>
        </l:main-panel>
    </l:layout>
</j:jelly>
