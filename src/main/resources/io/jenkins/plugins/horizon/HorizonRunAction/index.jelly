                        border-color: #64748b !important;
                        background: linear-gradient(180deg, rgba(100, 116, 139, 0.22) 0%, rgba(71, 85, 105, 0.14) 52%, #111827 100%) !important;
                        box-shadow: 0 0 0 2px #020617, 0 0 0 4.5px #64748b, 0 0 16px 3px rgba(100, 116, 139, 0.35), 0 8px 20px rgba(0, 0, 0, 0.55) !important;
                        opacity: 1 !important;
