                    .horizon-container.theme-dark .stage-node.status-FAILURE.selected .stage-active-strip {
                        background: linear-gradient(90deg, #dc2626, #f87171, #dc2626) !important;
                    }
                    .horizon-container.theme-dark .stage-node.status-FAILED.selected .stage-drawer-pointer,
                    .horizon-container.theme-dark .stage-node.status-FAILURE.selected .stage-drawer-pointer {
                        border-top-color: #ef4444 !important;
                        filter: drop-shadow(0 2px 4px rgba(239, 68, 68, 0.5)) !important;
                    }

                    .horizon-container.theme-dark .stage-node.status-SUCCESS.selected {
                        border-color: #10b981 !important;
                        background: linear-gradient(180deg, rgba(16, 185, 129, 0.24) 0%, rgba(5, 150, 105, 0.16) 52%, #11221c 100%) !important;
                        box-shadow: 0 0 0 2px #020617, 0 0 0 4.5px #10b981, 0 0 22px 5px rgba(16, 185, 129, 0.55), 0 8px 20px rgba(0, 0, 0, 0.55) !important;
                        animation: stageActiveGlowSuccess 2.6s ease-in-out infinite !important;
                    }
